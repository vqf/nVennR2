myv #noshow
# Chunk 5: fromText
toVenn <- 'Set1 Set2 Set3
a a b
b q d
c  e'
myv2 <- nVennDiagram(toVenn, byCol = 1, verbose = F)
myv2 #noshow
# Chunk 6: obj
