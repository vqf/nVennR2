myv2 #noshow
# Chunk 11: colors
myv2 <- setVennColor(myv2, "Set2", 'black')
myv2 #noshow
# Chunk 12: optPalette
myv2 <- setVennOpts(myv2, palette = 2)
myv2 #noshow
# Chunk 13: setPalette
